{
  "manifest_version": 3,
  "name": "Browser Lock",
  "version": "1.3.0",
  "description": "Protects your browser with a password, startup lock, idle timeout, PANIC key, and session preservation.",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "lock-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "PANIC: lock the browser immediately"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}