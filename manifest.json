{
  "manifest_version": 3,
  "name": "Browser Lock",
  "version": "1.0.0",
  "description": "Protects your browser with a password, idle timeout, and session preservation.",
  "permissions": [
    "storage",
    "tabs",
    "windows",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}